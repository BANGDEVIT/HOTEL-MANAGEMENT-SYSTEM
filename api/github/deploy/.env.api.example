# /opt/hotel/.env.api : biến cho NestJS. KHÔNG commit file thật.
# Neon: dùng connection string DIRECT (host không có "-pooler") để prisma migrate deploy chạy được
DATABASE_URL=postgresql://USER:***@HOST.neon.tech/DBNAME?sslmode=require

# Các biến còn lại: copy đúng TÊN biến từ .env local của bạn (JWT secret, thời hạn token...),
# giá trị production phải khác giá trị dev
# JWT_SECRET=***
