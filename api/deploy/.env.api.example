# /opt/hotel/.env.api : biến cho NestJS trên VPS. KHÔNG commit file thật, KHÔNG gửi qua chat.
# Không dùng dấu nháy cho thống nhất. Giá trị có dấu cách vẫn viết bình thường.

# ===== Database (Neon) =====
# App NestJS: URL có "-pooler"
DATABASE_URL=postgresql://neondb_owner:***@ep-xxx-pooler.c-6.us-east-1.aws.neon.tech/Hotel?sslmode=verify-full&connect_timeout=30
# Prisma CLI (prisma migrate deploy lúc CD): kết nối thẳng, KHÔNG có "-pooler"
DIRECT_URL=postgresql://neondb_owner:***@ep-xxx.c-6.us-east-1.aws.neon.tech/Hotel?sslmode=require&connect_timeout=30

# ===== Địa chỉ web thật (IP VPS hoặc tên miền), KHÔNG phải localhost =====
ALLOWED_ORIGINS=http://IP_VPS
FRONTEND_URL=http://IP_VPS

# ===== JWT: tạo mới, khác giá trị dev =====
JWT_SECRET=***
JWT_REFRESH_SECRET=***
JWT_EXPIRES_IN=900
RESET_PASSWORD=***

# ===== AWS S3 =====
AWS_ACCESS_KEY_ID=***
AWS_SECRET_ACCESS_KEY=***
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=hotel-management-images

# ===== Mail =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=***
MAIL_PASS=***
MAIL_FROM_NAME=ThousandStars
MAIL_FROM=***

# ===== Thông tin khách sạn =====
HOTEL_NAME=ThousandStars
HOTEL_PHONE=***
HOTEL_ADDRESS=***

# KHÔNG cần PORT, REDIS_HOST, REDIS_PORT, REDIS_PASSWORD ở đây:
# docker-compose.yml tự đặt (PORT=3000, REDIS_HOST=redis, mật khẩu lấy từ file .env)
